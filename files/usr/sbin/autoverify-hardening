#!/bin/sh
#
# autoverify-hardening - 查看/切换各维度的反检测措施
#
# 用法:
#   autoverify-hardening status            总览
#   autoverify-hardening ttl on [值]       开 TTL 归一化 (默认 64; 128 = 看起来像 Windows)
#   autoverify-hardening ttl off
#   autoverify-hardening ntp on|off
#   autoverify-hardening dns on|off
#   autoverify-hardening dhcp on|off [主机名] [厂商号]
#   autoverify-hardening ipv6 on|off
#
# 本脚本只改 /etc/config/autoverify 里的开关, 然后调用 autoverify-apply
# 把配置落到系统上。真正的事实来源始终是 UCI, 所以也可以用 LuCI 页面或 uci 命令改。
#
# 各维度的原理与代价见 docs/detection.md。

AV_LIB="${AV_LIB:-/usr/lib/autoverify/cfg.sh}"
# shellcheck disable=SC1090
[ -r "$AV_LIB" ] || { printf 'autoverify-hardening: 找不到 %s\n' "$AV_LIB" >&2; exit 1; }
. "$AV_LIB"
AV_DNS_LIB="${AV_DNS_LIB:-${AV_LIB%/*}/dns.sh}"
# shellcheck disable=SC1090
[ -r "$AV_DNS_LIB" ] || { printf 'autoverify-hardening: 找不到 %s\n' "$AV_DNS_LIB" >&2; exit 1; }
. "$AV_DNS_LIB"

APPLY=/usr/sbin/autoverify-apply
NFT_FILE=/etc/nftables.d/20-ttl-normalize.nft

die() { printf 'autoverify-hardening: %s\n' "$*" >&2; exit 1; }

need_uci() { command -v uci >/dev/null 2>&1 || die "找不到 uci"; }

apply() {
	[ -x "$APPLY" ] || die "找不到 $APPLY"
	"$APPLY" || die "$APPLY 执行失败"
}

usage() {
	cat >&2 <<EOF
用法: $0 {status|ttl|ntp|dns|dhcp|ipv6} [on|off]
      $0 ttl on [64|128]
      $0 dhcp on [主机名] [厂商号]

  dhcp 伪装主机名 / client-id / 厂商号, 并关掉 DHCPv6 的 FQDN。
  ipv6  关掉 LAN 的 RA 与 DHCPv6, 防止下发全局前缀后绕过 NAT。
EOF
	exit 2
}

do_toggle() {
	_section="$1"; _action="$2"
	case "$_action" in
		on|off) ;;
		*) usage ;;
	esac
	uci set "autoverify.$_section.enabled=$([ "$_action" = on ] && echo 1 || echo 0)"
	uci commit autoverify
	apply
	printf '%s: %s\n' "$_section" "$_action"
}

case "${1:-status}" in
status)
	need_uci
	# 各段的默认值不一样。ttl/ntp/dns 从第一个版本起就写在配置文件里, 默认值只是
	# 兰截; 而 dhcp/ipv6 是后加的选项 —— 升级用户的 /etc/config/autoverify 是 conffile
	# 保留的, 里面根本没有这两段。如果它们默认成关闭, 装上新版反而会把已经生效的
	# 伪装措施删掉、把 RA 重新打开。所以这两段缺失时按启用处理。
	_bool() {
		case "$1" in
			dhcp|ipv6) _d=1 ;;
			*)         _d=0 ;;
		esac
		[ "$(av_cfg_bool "$1" enabled "$_d")" = "1" ] && printf '启用' || printf '关闭'
	}
	echo "===== 配置 (UCI /etc/config/autoverify) ====="
	printf '  TTL 归一化 : %s  值=%s\n' "$(_bool ttl)" "$(av_cfg ttl ttl 64)"
	printf '  NTP 收敛   : %s\n' "$(_bool ntp)"
	printf '  DNS 收敛   : %s\n' "$(_bool dns)"
	if dns_doh_url; then
		printf '  DoH 上游   : %s (%s)\n' "$_doh_url" "$_doh_provider"
		printf '  Bootstrap  : %s (仅 DoH 服务域名)\n' "$_doh_bootstrap"
	else
		echo '  DoH 上游   : 配置无效'
	fi
	printf '  DHCP 伪装  : %s  主机名=%s 厂商=%s\n' "$(_bool dhcp)" \
		"$(av_cfg dhcp hostname "(留空, 首次应用时生成)")" "$(av_cfg dhcp vendorid "(OpenWrt 默认)")"
	printf '  IPv6 防护  : %s\n' "$(_bool ipv6)"
	echo
	echo "===== 系统实际状态 ====="
	if [ -e "$NFT_FILE" ]; then
		echo "  nft 规则文件: 存在"
	else
		echo "  nft 规则文件: 不存在"
	fi
	if command -v nft >/dev/null 2>&1; then
		nft list chain inet fw4 ttl_normalize 2>/dev/null | grep -E 'packets|ttl set' | sed 's/^/    /'
		nft list ruleset 2>/dev/null | grep -E 'ntp-converge|dns-converge' | sed 's/^/    /'
		nft list ruleset 2>/dev/null | grep -q flowtable && \
			echo "  ⚠️  检测到 flowtable(流量卸载), TTL 规则会漏掉被卸载的连接"
	fi
	printf '  dnsmasq 53 : %s 个 udp 监听\n' "$(netstat -lnu 2>/dev/null | grep -cE ':53[[:space:]]')"
	printf '  DoH 代理   : %s 个 127.0.0.1:5053 udp 监听\n' "$(netstat -lnu 2>/dev/null | grep -cE '127\.0\.0\.1:5053[[:space:]]')"
	printf '  ntpd 123   : %s 个 udp 监听\n' "$(netstat -lnu 2>/dev/null | grep -cE ':123[[:space:]]')"
	# DHCP 伪装与 IPv6 防护落在 network / dhcp 两个包自己的配置里,
	# 所以要看的不是 UCI 开关而是系统里实际生效的值。
	_if=$(av_cfg dhcp iface wan); [ -n "$_if" ] || _if=wan
	printf '  DHCP 实际  : hostname=%s clientid=%s vendorid=%s\n' \
		"$(uci -q get "network.$_if.hostname" || echo '(未设)')" \
		"$(uci -q get "network.$_if.clientid" || echo '(未设, 会发 DUID)')" \
		"$(uci -q get "network.$_if.vendorid" || echo '(未设, 会发 udhcp 版本)')"
	printf '  DHCPv6 FQDN: %s\n' \
		"$([ "$(uci -q get "network.${_if}6.noclientfqdn")" = "1" ] && echo '已关(不再泄露主机名)' || echo '⚠️  未关, 仍会用系统主机名')"
	printf '  LAN RA/DHCPv6: %s / %s\n' \
		"$(uci -q get dhcp.lan.ra || echo '(默认)')" "$(uci -q get dhcp.lan.dhcpv6 || echo '(默认)')"
	case "$(uci -q get dhcp.lan.ra)" in
		server|relay) echo "    ⚠️  LAN 仍在发 RA: 一旦上游下发全局前缀, 客户端会绕过 NAT" ;;
	esac
	;;
ttl)
	need_uci
	if [ "${2:-}" = "on" ] && [ -n "${3:-}" ]; then
		case "$3" in ''|*[!0-9]*) die "TTL 必须是数字: $3" ;; esac
		if [ "$3" -lt 1 ] || [ "$3" -gt 255 ]; then
			die "TTL 必须在 1..255"
		fi
		uci set "autoverify.ttl.ttl=$3"
	fi
	do_toggle ttl "${2:-}"
	;;
ntp)    need_uci; do_toggle ntp "${2:-}" ;;
dns)    need_uci; do_toggle dns "${2:-}" ;;
dhcp)
	need_uci
	# 允许顺便换主机名 / 厂商号:  dhcp on [主机名] [厂商号]
	# 主机名留空则交给 apply 随机生成。
	if [ "${2:-}" = "on" ]; then
		if [ -n "${3:-}" ]; then uci set "autoverify.dhcp.hostname=$3"; fi
		if [ -n "${4:-}" ]; then uci set "autoverify.dhcp.vendorid=$4"; fi
		uci commit autoverify
	fi
	do_toggle dhcp "${2:-}"
	;;
ipv6)   need_uci; do_toggle ipv6 "${2:-}" ;;
*)      usage ;;
esac
