#!/bin/sh
#
# autoverify-apply - 把 /etc/config/autoverify 的配置落到系统上
#
# 唯一事实来源是 UCI。本脚本是幂等的：重复执行结果一致。
#
#   hardening.ttl.enabled -> /etc/nftables.d/20-ttl-normalize.nft
#   hardening.ntp.enabled -> firewall.ntp_converge + system.ntp.enable_server
#   dns.enabled -> dnsmasq DoH 上游；dns.redirect -> LAN 53 重定向（默认关闭）
#   hardening.dhcp.enabled -> network.<iface>.hostname/clientid/vendorid + wan6.noclientfqdn
#   hardening.ipv6.enabled -> dhcp.lan 的 ra / dhcpv6 关掉
#
# 最后统一做一次 fw4 reload，而不是每个组件各 reload 一次
# （fw4 reload 会重建整张 nft 表，做三次等于瞬断三次）。
#
# 开机时由 /etc/init.d/autoverify 调用。

AV_LIB="${AV_LIB:-/usr/lib/autoverify/cfg.sh}"
# shellcheck disable=SC1090
[ -r "$AV_LIB" ] || { printf 'autoverify-apply: 找不到 %s\n' "$AV_LIB" >&2; exit 1; }
. "$AV_LIB"
AV_DNS_LIB="${AV_DNS_LIB:-${AV_LIB%/*}/dns.sh}"
# shellcheck disable=SC1090
[ -r "$AV_DNS_LIB" ] || { printf 'autoverify-apply: 找不到 %s\n' "$AV_DNS_LIB" >&2; exit 1; }
. "$AV_DNS_LIB"

NFT_FILE=/etc/nftables.d/20-ttl-normalize.nft
NTP_SEC="ntp_converge"
DNS_SEC_UDP="dns_converge_udp"
DNS_SEC_TCP="dns_converge_tcp"

log() { printf 'autoverify-apply: %s\n' "$*" >&2; }

need_uci() {
	command -v uci >/dev/null 2>&1 || { log "找不到 uci"; exit 1; }
}

lan_ip() {
	_ip=$(uci -q get network.lan.ipaddr)
	[ -n "$_ip" ] || return 1
	printf '%s\n' "${_ip%%/*}"
}

# ---------------------------------------------------------------- TTL ------

apply_ttl() {
	_lan=$(av_cfg network lan_dev "br-lan")
	if [ "$(av_cfg_bool ttl enabled 0)" = "1" ]; then
		_ttl=$(av_cfg ttl ttl "64")
		case "$_ttl" in ''|*[!0-9]*) log "TTL 值非法: $_ttl，跳过"; return 1 ;; esac
		mkdir -p /etc/nftables.d
		cat > "$NFT_FILE" <<EOF
## 本文件由 /usr/sbin/autoverify-apply 从 UCI 生成, 手工修改会被覆盖。
## 关闭: uci set autoverify.ttl.enabled='0' && /usr/sbin/autoverify-apply
##
## 把从 LAN 转发出去的 IPv4 包 TTL 统一为 $_ttl, 使外部看不到多个终端的 TTL 差异。

chain ttl_normalize {
	type filter hook postrouting priority -145; policy accept;
	iifname "$_lan" counter ip ttl set $_ttl comment "ttl-normalize: LAN->WAN TTL=$_ttl"
}
EOF
		return 0
	fi
	rm -f "$NFT_FILE"
	return 0
}

# 检测流量卸载（被卸载的连接跳过 postrouting，TTL 规则会静默失效）
warn_offload() {
	command -v nft >/dev/null 2>&1 || return 0
	nft list ruleset 2>/dev/null | grep -q flowtable || return 0
	log "警告: 检测到 flowtable(流量卸载)，被卸载的连接会跳过 postrouting hook，"
	log "      TTL 改写对它们不执行。关闭方法:"
	log "        uci set firewall.@defaults[0].flow_offloading='0'"
	log "        uci set firewall.@defaults[0].flow_offloading_hw='0'"
}

# ---------------------------------------------------------------- NTP ------

apply_ntp() {
	_ip=$(lan_ip) || { log "读不到 network.lan.ipaddr"; return 1; }

	if [ "$(av_cfg_bool ntp enabled 0)" = "1" ]; then
		uci set system.ntp.enable_server='1'
		_srv=$(av_cfg ntp server)
		if [ -n "$_srv" ]; then
			uci -q delete system.ntp.server
			for _s in $_srv; do uci add_list system.ntp.server="$_s"; done
		fi
		uci -q delete "firewall.$NTP_SEC"
		uci set "firewall.$NTP_SEC"=redirect
		uci set "firewall.$NTP_SEC".name='ntp-converge'
		uci set "firewall.$NTP_SEC".src='lan'
		uci set "firewall.$NTP_SEC".proto='udp'
		uci set "firewall.$NTP_SEC".src_dport='123'
		uci set "firewall.$NTP_SEC.dest_ip=$_ip"
		uci set "firewall.$NTP_SEC".dest_port='123'
		uci set "firewall.$NTP_SEC".target='DNAT'
	else
		uci -q delete "firewall.$NTP_SEC"
		uci set system.ntp.enable_server='0'
	fi
	uci commit system
	return 0
}

# ---------------------------------------------------------------- DNS ------

apply_dns() {
	# 先移除旧版本或上次启用的接管规则，即使后续 DoH 应用失败也不残留。
	uci -q delete "firewall.$DNS_SEC_UDP"
	uci -q delete "firewall.$DNS_SEC_TCP"

	add_dns_redirect() {
		_sec="$1"; _proto="$2"
		uci -q delete "firewall.$_sec"
		uci set "firewall.$_sec"=redirect
		uci set "firewall.$_sec.name=dns-converge-$_proto"
		uci set "firewall.$_sec".src='lan'
		uci set "firewall.$_sec.proto=$_proto"
		uci set "firewall.$_sec".src_dport='53'
		uci set "firewall.$_sec.dest_ip=$_ip"
		uci set "firewall.$_sec".dest_port='53'
		uci set "firewall.$_sec".target='DNAT'
	}

	if [ "$(av_cfg_bool dns enabled 0)" = "1" ]; then
		# 本机 53 没人听就别开, 否则客户端直接断解析
		if ! netstat -lnu 2>/dev/null | grep -qE ':53[[:space:]]'; then
			log "本机 53 端口没有监听(dnsmasq 没跑?)，跳过路由器 DoH"
			return 1
		fi
		dns_doh_apply || return 1
		if [ "$(av_cfg_bool dns redirect 0)" = "1" ]; then
			_ip=$(lan_ip) || { log "读不到 network.lan.ipaddr，无法接管 LAN DNS"; return 1; }
			add_dns_redirect "$DNS_SEC_UDP" udp
			add_dns_redirect "$DNS_SEC_TCP" tcp
		fi
	else
		dns_doh_restore || return 1
	fi
	return 0
}

# --------------------------------------------------------------- DHCP ------
#
# 校园网的 DHCP 服务器会记录下面三个字段, 而 OpenWrt 的默认值等于直接自报家门:
#   hostname     = "OpenWrt"
#   client-id    = DUID(一串 ff 开头的二进制, 普通终端发的是 01<MAC>)
#   vendor-class = "udhcp <版本号>"   ← 连 DHCP 客户端实现和版本都报出去了
#
# 换个角度: 同一 IP 下这些字段的取值风格, 也是判定"这是路由器还是终端"的依据。
#
# 另外 DHCPv6 的 Client-FQDN 用的是系统主机名, 会把 "OpenWrt" 再泄露一次,
# 用 network.<iface>6.noclientfqdn 关掉(odhcp6c 的 -f)。

# 生成一个形如 LAPTOP-XXXXXXXX 的名字(Windows 默认命名风格)。
#
# 用 awk 把随机串逐字节映射到字符表, 而不是 awk 的 srand() —— 后者需要
# 一个数值种子, 而取种子的常规做法(od -tu4 /dev/urandom)在这台路由器上
# 不可用: busybox 根本没编 od。种子会静默退化成 PID, 同一秒内连调两次
# 就得到完全相同的名字。已在设备上实测到过这个现象。
#
# 优先读内核 uuid(每个字节都是随机的), 读不到再退回 urandom 过 tr。
# 映射用 v%32: 一个字节 0..255 正好均分给 32 个字符表位置, 分布是均匀的。
gen_hostname() {
	_u=$(tr -d '-' < /proc/sys/kernel/random/uuid 2>/dev/null | tr 'A-F' 'a-f')
	[ -n "$_u" ] || _u=$(head -c 32 /dev/urandom 2>/dev/null | tr -dc 'a-f0-9')
	[ -n "$_u" ] || return 1
	awk -v u="$_u" 'BEGIN {
		t = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
		hex = "0123456789abcdef";
		n = "";
		for (i = 0; i < 8; i++) {
			p = substr(u, i * 2 + 1, 2);
			v = index(hex, substr(p, 1, 1)) - 1;
			v = v * 16 + index(hex, substr(p, 2, 1)) - 1;
			n = n substr(t, (v % 32) + 1, 1);
		}
		printf "LAPTOP-%s\n", n;
	}'
}

# 输出 WAN 口 MAC 的裸小写十六进制(无分隔符)。
wan_mac_hex() {
	_dev=$(av_cfg network wan_if "wan")
	_mac=$(cat "/sys/class/net/$_dev/address" 2>/dev/null)
	[ -n "$_mac" ] || return 1
	printf '%s' "$_mac" | tr -d ':' | tr 'A-F' 'a-f'
}

apply_dhcp() {
	_if=$(av_cfg dhcp iface "wan")
	[ -n "$_if" ] || _if=wan
	_wan6="${_if}6"

	if [ "$(av_cfg_bool dhcp enabled 1)" != "1" ]; then
		uci -q delete "network.$_if.hostname"
		uci -q delete "network.$_if.clientid"
		uci -q delete "network.$_if.vendorid"
		uci -q delete "network.$_wan6.noclientfqdn"
		uci commit network
		return 0
	fi

	# 主机名留空时生成一次并写回 UCI —— 必须稳定, 否则每次 apply 都换名字,
	# 那本身就是个特征。
	_hn=$(av_cfg dhcp hostname)
	if [ -z "$_hn" ]; then
		_hn=$(gen_hostname) || { log "生成主机名失败, 跳过 DHCP 伪装"; return 1; }
		uci set "autoverify.dhcp.hostname=$_hn"
		uci commit autoverify
		log "已生成主机名 $_hn (写回 /etc/config/autoverify)"
	fi

	_mac=$(wan_mac_hex) || { log "读不到 WAN 口 MAC, 跳过 DHCP 伪装"; return 1; }

	_changed=0
	# 注意: 这里必须用 "$1.$2=$3" 而不是 "$1.$2='$3'" —— 整个参数已经用双引号
	# 包住, 内层单引号会作为字面量存进 UCI, 值会变成 '1' 而不是 1。
	# dhcpv6.sh 里是 [ "$noclientfqdn" = "1" ], 带引号就匹配不上, -f 不会加上。
	_same() {
		_cur=$(uci -q get "network.$1.$2")
		[ "$_cur" = "$3" ] && return 0
		log "  $1.$2: [$_cur] -> [$3]"
		return 1
	}

	_same "$_if" hostname "$_hn"      || _changed=1
	_same "$_if" clientid "01$_mac"   || _changed=1
	_same "$_if" vendorid "$(av_cfg dhcp vendorid)" || _changed=1
	_same "$_wan6" noclientfqdn 1      || _changed=1

	uci set "autoverify.dhcp.hostname=$_hn"
	uci set "network.$_if.hostname=$_hn"
	uci set "network.$_if.clientid=01$_mac"
	_vid=$(av_cfg dhcp vendorid)
	if [ -n "$_vid" ]; then
		uci set "network.$_if.vendorid=$_vid"
	else
		uci -q delete "network.$_if.vendorid"
	fi
	# 只在 wan6 这个 UCI 段确实存在时才动它, 否则会凭空造出一个多余的接口
	if uci -q get "network.$_wan6" >/dev/null 2>&1; then
		uci set "network.$_wan6.noclientfqdn=1"
	fi
	uci commit network

	# 改 client-id 有可能让 DHCP 服务器重新分配地址, 所以只在真的变了才重开接口。
	# 开机时本脚本跑在 network 之后, 此时值已经一致, 不会重复 ifup。
	if [ "$_changed" = "1" ]; then
		log "DHCP 伪装已更新, 重开 $_if 让新参数生效"
		ifup "$_if" >/dev/null 2>&1 || log "ifup $_if 失败, 将在下次续租时生效"
	fi
	return 0
}

# --------------------------------------------------------------- IPv6 ------
#
# 这个开关防的是"全军覆没"级别的事故:
#
#   本项目所有 L3/L4 措施的前提是"所有设备藏在 NAT 后面"。而 IPv6 不做 NAT ——
#   只要校园网下发一个全局前缀、且 LAN 还在发 RA, 每台客户端就会直接拿到可路由的
#   IPv6 地址, 绕过本机所有出站检查, TTL/NTP/DNS/UA 全部失效。
#
# 关掉 LAN 的 RA 与 DHCPv6 后, LAN 只跑 IPv4, 从结构上不可能发生这种泄露。
# 代价: 局域网内也没有 IPv6 了(当前校园网本来就不提供)。

apply_ipv6() {
	if [ "$(av_cfg_bool ipv6 enabled 1)" = "1" ]; then
		uci set dhcp.lan.ra='disabled'
		uci set dhcp.lan.dhcpv6='disabled'
		uci -q delete dhcp.lan.ra_slaac
		uci -q delete dhcp.lan.ra_flags
	else
		uci set dhcp.lan.ra='server'
		uci set dhcp.lan.dhcpv6='server'
		uci set dhcp.lan.ra_slaac='1'
	fi
	uci commit dhcp
	return 0
}

# --------------------------------------------------------------- 主流程 -----

main() {
	need_uci
	_failed=0

	apply_ttl
	apply_ntp
	apply_dns || _failed=1
	apply_dhcp
	apply_ipv6
	uci commit firewall

	/etc/init.d/firewall reload >/dev/null 2>&1 || log "firewall reload 失败"
	/etc/init.d/sysntpd restart >/dev/null 2>&1
	/etc/init.d/odhcpd restart >/dev/null 2>&1
	/etc/init.d/dnsmasq restart >/dev/null 2>&1

	[ "$(av_cfg_bool ttl enabled 0)" = "1" ] && warn_offload

	if [ "$_failed" = 0 ]; then
		log "已应用: ttl=$(av_cfg_bool ttl enabled 0) ntp=$(av_cfg_bool ntp enabled 0) dns=$(av_cfg_bool dns enabled 0) dhcp=$(av_cfg_bool dhcp enabled 1) ipv6=$(av_cfg_bool ipv6 enabled 1)"
	else
		log 'DNS DoH 收敛应用失败，请检查依赖、配置及代理监听'
	fi
	return "$_failed"
}

main
