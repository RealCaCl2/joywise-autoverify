#!/bin/sh
#
# joywise-autoverify - OpenWrt 校园网门户 (zportal) 自动认证
# 运行时命令和配置命名空间为 autoverify, 以兼容现有安装。
#
# 子命令:
#   check   仅检测连通性            退出码 0=在线, 1=离线
#   login   无条件认证一次
#   once    检测后按需认证一次
#   daemon  常驻循环, 由 /etc/init.d/autoverify 启动
#   debug   打印探测与解析结果, 不提交认证
#   validate 只读校验配置与本机依赖
#   status  查看运行状态 (可选 --json/--probe)
#   audit   只读审计网络与防火墙实际状态 (可选 --json)
#   update-check  查 GitHub Releases, 与本机安装版本比较(只读)
#
# 配置: UCI /etc/config/autoverify (读取顺序见 usr/lib/autoverify/cfg.sh)
#
# 认证流程:
#   1. 向 PROBE_URLS 发起明文 HTTP 请求;
#   2. 未认证时 NAS 把客户端引到登录页。实测这台 NAS 回的是 HTTP 200 且地址藏在
#      页面内跳转里(不是 302), 且它给的 /zportal/login? 本身还会再 302 一次,
#      所以 302 / 200+Location / 页面内链接 三种形态都要认, 并跟随多跳;
#   3. GET 该登录页, 解析出 7 个被服务端加密的隐藏字段;
#   4. POST /zportal/login/do 提交 username/pwd + 这些隐藏字段, 再跟随 nextPage。
#
# 隐藏字段由门户按明文参数加密生成(跨会话恒定), 因此无需复现其加密算法,
# 每次认证前重新抓取一次登录页即可。

AV_LIB="${AV_LIB:-/usr/lib/autoverify/cfg.sh}"
# shellcheck disable=SC1090
if [ ! -r "$AV_LIB" ]; then
	printf 'autoverify: 找不到 %s\n' "$AV_LIB" >&2
	exit 1
fi
. "$AV_LIB"

AV_LOCK_LIB="${AV_LOCK_LIB:-${AV_LIB%/*}/lock.sh}"
# shellcheck disable=SC1090
if [ ! -r "$AV_LOCK_LIB" ]; then
	printf 'autoverify: 找不到 %s\n' "$AV_LOCK_LIB" >&2
	exit 1
fi
. "$AV_LOCK_LIB"

AV_STATE_LIB="${AV_STATE_LIB:-${AV_LIB%/*}/state.sh}"
# shellcheck disable=SC1090
if [ ! -r "$AV_STATE_LIB" ]; then
	printf 'autoverify: 找不到 %s\n' "$AV_STATE_LIB" >&2
	exit 1
fi
. "$AV_STATE_LIB"

# DNS 上游的认证前后切换（dns.mode=post_auth）。
AV_DNS_LIB="${AV_DNS_LIB:-${AV_LIB%/*}/dns.sh}"
# shellcheck disable=SC1090
if [ ! -r "$AV_DNS_LIB" ]; then
	printf 'autoverify: 找不到 %s\n' "$AV_DNS_LIB" >&2
	exit 1
fi
. "$AV_DNS_LIB"

# --------------------------------------------------------------- 读取配置 ---
# 唯一事实来源是 UCI /etc/config/autoverify。
# 无 uci 命令时(本地测试)自动退回同名环境变量, 再退回默认值。

USERNAME=$(av_cfg main username)
PASSWORD=$(av_cfg main password)
PORTAL_HOST=$(av_cfg portal host "")
PORTAL_PORT=$(av_cfg portal port "9090")
PORTAL_URL=$(av_cfg portal url)
PROBE_URLS=$(av_cfg tuning probe_urls "http://www.gstatic.com/generate_204")
EXPECT_CODE=$(av_cfg tuning expect_code "204")
HTTP_TIMEOUT=$(av_cfg tuning http_timeout "8")
CHECK_INTERVAL=$(av_cfg tuning check_interval "60")
RETRY_INTERVAL=$(av_cfg tuning retry_interval "20")
MAX_RETRY_INTERVAL=$(av_cfg tuning max_retry_interval "300")
# 登录 POST 前的随机延迟上限（秒，0 = 关闭）。真实浏览器从打开登录页到提交
# 至少需要数秒；抓完页面 0 秒提交是明显的脚本特征。
LOGIN_DELAY=$(av_cfg tuning login_delay "2")
VERBOSE=$(av_cfg_bool tuning verbose "0")
LOCK_ENABLED=$(av_cfg_bool tuning lock_enabled "1")
LOCK_MAX_AGE=$(av_cfg tuning lock_max_age "300")
STATE_ENABLED=$(av_cfg_bool tuning state_enabled "1")
NEXTPAGE_STRICT=$(av_cfg_bool tuning nextpage_strict "1")
WAN_IF=$(av_cfg network wan_if)

# 仅供本地测试覆盖；设备上固定使用 /var/run/autoverify。
LOCK_ROOT="${AUTOVERIFY_RUN_DIR:-/var/run/autoverify}"
AV_STATE_ENABLED="$STATE_ENABLED"
AV_STATE_DIR="$LOCK_ROOT"
AV_STATE_PERSIST_DIR="${AUTOVERIFY_STATE_DIR:-/var/lib/autoverify}"
AUTOVERIFY_SOURCE="${AUTOVERIFY_SOURCE:-manual}"

# 请求 User-Agent。
#
# 探测走的是明文 HTTP, 校园网 DPI 直接看得见这个头, 所以它绝不能自报家门。
# 旧值 "Mozilla/5.0 (Linux; OpenWrt) autoverify" 等于每 60 秒对外广播一次
# "这台设备跑着 OpenWrt 和一个叫 autoverify 的工具"。
# 也不能换成虚构或过时的 UA —— 那种组合本身同样显眼, 要用真实且当前主流的串。
#
# 应与 UA-Mask 的 UAmask.main.ua 一致: 探测流量与 NAT 后的客户端流量同源同 IP,
# 两边 UA 不同就等于告诉对面这台机器上住着两种浏览器。
USER_AGENT=$(av_cfg tuning user_agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36")

# 探测/登录都走明文 HTTP，请求头对校园网 DPI 和门户直接可见。
# 只补浏览器稳定会发的头；不伪造 Sec-Ch-Ua（品牌列表随版本变化，写错反而更显眼）。
ACCEPT_LANGUAGE='zh-CN,zh;q=0.9,en;q=0.8'
ACCEPT_HTML='text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8'

# portal.host 未设置时 base 留空 —— 门户地址靠响应里的 /zportal/ 自动识别。
# base 只在"响应给的是相对路径"时用来补全, 见 abspath()。
if [ -z "${PORTAL_BASE:-}" ] && [ -n "$PORTAL_HOST" ]; then
	PORTAL_BASE="http://${PORTAL_HOST}:${PORTAL_PORT}"
fi
PORTAL_BASE="${PORTAL_BASE:-}"
PORTAL_PATH="/zportal/loginForWeb"
LOGIN_PATH="/zportal/login/do"

# --------------------------------------------------------------- 基础工具 ---

log() {
	printf 'autoverify: %s\n' "$*" >&2
}

logv() {
	[ "$VERBOSE" = "1" ] && log "$*"
	return 0
}

die() {
	log "错误: $*"
	exit 1
}

# 可被 SIGTERM 打断的 sleep。
# busybox ash 要等前台子进程结束后才处理 trap, 所以把 `sleep 300` 放前台会让
# `/etc/init.d/autoverify stop` 一直卡到 procd 超时后 SIGKILL; 更糟的是这期间
# start 已经跑起来了, 会变成两个 daemon 同时发认证请求。
# 把 sleep 提到后台再 wait: wait 会被信号中断, trap 就能及时执行。
interruptible_sleep() {
	sleep "$1" &
	_sleep_pid=$!
	wait "$_sleep_pid" 2>/dev/null
	_sleep_pid=""
	if [ "$STOP_REQUESTED" = "1" ]; then
		log "收到停止信号, 退出"
		exit 0
	fi
	return 0
}

# 在固定间隔上加减随机抖动，避免精确的 60/20/40/80 秒节拍。
# _max > 0 时把结果钳在上限内（退避上限）。
jittered_sleep() {
	_base=$1
	_pct=${2:-15}
	_max=${3:-0}
	case "$_base" in ''|*[!0-9]*) interruptible_sleep "${_base:-0}"; return 0 ;; esac
	[ "$_base" -gt 0 ] || { interruptible_sleep "$_base"; return 0; }
	_rand=${RANDOM:-0}
	case "$_rand" in ''|*[!0-9]*) _rand=0 ;; esac
	_delta=$(( _base * _pct / 100 ))
	[ "$_delta" -lt 1 ] && _delta=1
	_t=$(( _base + (_rand % (_delta * 2 + 1)) - _delta ))
	[ "$_t" -lt 1 ] && _t=1
	case "$_max" in
		''|*[!0-9]*) ;;
		*) [ "$_max" -gt 0 ] && [ "$_t" -gt "$_max" ] && _t="$_max" ;;
	esac
	interruptible_sleep "$_t"
}

need_curl() {
	command -v curl >/dev/null 2>&1 && return 0
	die "未找到 curl, 请先安装: opkg update && opkg install curl"
}

# 探测一个 URL, 输出 "<http状态码> <重定向目标>" (不跟随重定向)
# 响应头存到 $TMP/headers, 响应体存到 $TMP/body。
# 必须存响应头: 实测这台 NAS 不是用 302, 而是回 200, 门户地址既可能在
# 页面里的 JS 跳转中, 也可能在 200 响应的 Location 头中。
probe() {
	curl -s -m "$HTTP_TIMEOUT" -A "$USER_AGENT" --compressed \
		-H 'Accept: */*' \
		-H "Accept-Language: $ACCEPT_LANGUAGE" \
		-H 'Connection: keep-alive' \
		-D "$TMP/headers" -o "$TMP/body" \
		-w '%{http_code} %{redirect_url}' \
		"$1" 2>/dev/null
}

# 每次探测前随机化地址顺序：固定从第一个地址开始，长期看也是一个稳定节拍。
# 单地址时直接返回，避免多起 awk 进程。
shuffled_probe_urls() {
	set -- $PROBE_URLS
	[ "$#" -eq 0 ] && return 0
	[ "$#" -eq 1 ] && { printf '%s\n' "$1"; return 0; }
	printf '%s\n' "$@" | awk -v seed="${RANDOM:-0}" '
		BEGIN { srand(seed) }
		{ a[NR] = $0 }
		END {
			for (i = NR; i > 1; i--) {
				j = int(rand() * i) + 1
				t = a[i]; a[i] = a[j]; a[j] = t
			}
			for (i = 1; i <= NR; i++) print a[i]
		}'
}

split_probe_result() {
	case "$1" in
		*" "*) PROBE_CODE="${1%% *}"; PROBE_LOC="${1#* }" ;;
		*)    PROBE_CODE="$1";        PROBE_LOC="" ;;
	esac
	PROBE_LOC=$(printf '%s' "$PROBE_LOC" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
}

# --------------------------------------------------------------- 网络状态 ---

# 离线: 未认证; 返回 0 表示在线
check_online() {
	for _u in $(shuffled_probe_urls); do
		split_probe_result "$(probe "$_u")"
		logv "探测 $_u -> ${PROBE_CODE:-无响应}${PROBE_LOC:+ (重定向到 $PROBE_LOC)}"
		[ -n "$PROBE_LOC" ] && continue
		[ "$PROBE_CODE" = "$EXPECT_CODE" ] && return 0
	done
	return 1
}

# 判断一个 URL 是否指向门户
#
# 通用兜底是路径里的 /zportal/ , PORTAL_PATH / PORTAL_HOST 只是额外的提示。
# 这两个提示为空时必须整条跳过 —— case 的 *""* 能匹配任意字符串, 会把任何地址
# 都判成门户, 于是第一跳跳转就被当成登录页, 后面全错。
is_portal_url() {
	case "$1" in
		*/zportal/*) return 0 ;;
	esac
	if [ -n "$PORTAL_PATH" ]; then
		case "$1" in *"$PORTAL_PATH"*) return 0 ;; esac
	fi
	if [ -n "$PORTAL_HOST" ]; then
		case "$1" in *"$PORTAL_HOST"*) return 0 ;; esac
	fi
	return 1
}

# 把可能相对的地址补成绝对地址。
# 基准优先用 portal.host 拼出的 base; 没设就用发起请求的那个地址的 origin
# —— HTTP 里相对 Location 本来就是相对请求地址解析的。
# 补不出来就返回非 0, 让调用方走"定位失败"分支,
# 而不是拿一个 http://:9090/... 这种坏地址去请求。
abspath() {
	case "$1" in
		http://*|https://*) _url="$1" ;;
		/*) _url="" ;;
		*) _url="" ;;
	esac

	if [ -n "$_url" ]; then
		[ "$(printf '%s' "$_url" | wc -c | tr -d ' ')" -le 2048 ] || return 1
		printf '%s\n' "$_url"
		return 0
	fi

	_base="$PORTAL_BASE"
	_request="${2:-}"
	if [ -n "$_request" ]; then
		_request_origin=$(printf '%s' "$_request" | sed -n 's#^\(https\{0,1\}://[^/]*\).*#\1#p')
		[ -n "$_request_origin" ] && _base="$_request_origin"
	fi
	[ -n "$_base" ] || return 1
	case "$1" in
		/*) _url="$_base$1" ;;
		*)
			_request_path=$(printf '%s' "$_request" | sed -n 's#^https\{0,1\}://[^/]*\(/.*\)$#\1#p')
			[ -n "$_request_path" ] || _request_path=/
			_dir=${_request_path%/*}/
			_url="$_base$_dir$1"
			;;
	esac
	[ "$(printf '%s' "$_url" | wc -c | tr -d ' ')" -le 2048 ] || return 1
	printf '%s\n' "$_url"
}

# 从文件里提取门户地址。$2 是拿到这份响应的请求地址, 用于补全相对路径。
# 按可信度依次尝试, 越靠前越可信。
# 实测 NAS 给的是 /zportal/login?..., 而浏览器地址栏里是 /zportal/loginForWeb?...,
# 两者都要能认出来; 同时要避免误匹配到 /zportal/js/jquery.js 这类静态资源。
extract_portal_url() {
	_p=""
	for _pat in \
		"http[^\"'<> ]*loginForWeb[^\"'<> ]*" \
		"http[^\"'<> ]*/zportal/login[^\"'<> ]*" \
		"/[^\"'<> ]*loginForWeb[^\"'<> ]*" \
		"/[^\"'<> ]*/zportal/login[^\"'<> ]*"
	do
		_p=$(grep -o "$_pat" "$1" 2>/dev/null | head -n 1)
		[ -n "$_p" ] && break
	done
	if [ -n "$_p" ]; then
		_p=$(abspath "$_p" "${2:-}") || _p=""
	fi
	printf '%s\n' "$_p"
}

# 从探测结果中找出门户登录页地址
find_portal_url() {
	for _u in $(shuffled_probe_urls); do
		split_probe_result "$(probe "$_u")"
		logv "门户探测摘要: $_u HTTP ${PROBE_CODE:-?} redirect=[${PROBE_LOC:-}]"

		# a) 3xx 重定向
		if [ -n "$PROBE_LOC" ] && is_portal_url "$PROBE_LOC"; then
			_p=$(abspath "$PROBE_LOC" "$_u") || _p=""
			[ -n "$_p" ] && { printf '%s\n' "$_p"; return 0; }
		fi
		if [ -n "$PROBE_LOC" ]; then
			logv "探测重定向不是 zportal: $PROBE_LOC"
		fi

		# b) 200 响应也可能带 Location 头
		_loc=$(tr -d '\r' < "$TMP/headers" 2>/dev/null | sed -n 's/^[Ll]ocation:[[:space:]]*//p' | head -n 1 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
		if [ -n "$_loc" ] && is_portal_url "$_loc"; then
			_loc=$(abspath "$_loc" "$_u") || _loc=""
			[ -n "$_loc" ] && { printf '%s\n' "$_loc"; return 0; }
		fi

		# c) 页面内跳转 (meta refresh / JS / 直接输出的链接)
		_p=$(extract_portal_url "$TMP/body" "$_u")
		[ -n "$_p" ] && { printf '%s\n' "$_p"; return 0; }

		# d) 多跳重定向: 跟随后取最终地址
		if [ -n "$PROBE_LOC" ]; then
			logv "跟随中间跳转: $PROBE_LOC"
			_p=$(curl -s -L --max-redirs 5 -m "$HTTP_TIMEOUT" -A "$USER_AGENT" --compressed \
				-H "Accept: $ACCEPT_HTML" \
				-H "Accept-Language: $ACCEPT_LANGUAGE" \
				-H 'Connection: keep-alive' \
				-D "$TMP/headers" -o "$TMP/body" -w '%{url_effective}' "$_u" 2>/dev/null)
			_follow_rc=$?
			[ "$_follow_rc" -eq 0 ] || logv "跟随探测重定向失败: curl 退出码 $_follow_rc"
			if is_portal_url "$_p"; then printf '%s\n' "$_p"; return 0; fi
			_p=$(extract_portal_url "$TMP/body" "$_u")
			[ -n "$_p" ] && { printf '%s\n' "$_p"; return 0; }
		fi
	done
	return 1
}

default_if() {
	if [ -n "$WAN_IF" ]; then
		printf '%s\n' "$WAN_IF"
		return 0
	fi
	ip route show default 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1
}

if_ip4() {
	ip -4 addr show dev "$1" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n 1
}

if_mac() {
	[ -r "/sys/class/net/$1/address" ] && tr -d '\r\n' < "/sys/class/net/$1/address"
}

# aa:bb:cc:dd:ee:ff -> AABB-CCDD-EEFF
mac_cisco() {
	printf '%s' "$1" | tr -d ':' | tr 'a-f' 'A-F' | sed 's/\(....\)/\1-/g; s/-$//'
}

# --------------------------------------------------------------- HTML 解析 ---

# field <字段名> <已按标签拆行的 HTML 文件>
# 取 name="<字段名>" 之后的第一个 value="..."。
# 取“第一个”而非最后一个: HTML 解析器遇到重复属性时保留第一个,
# 门户的 validCode 输入框就写成了 value="验证码" ... value="",
# 浏览器实际提交的是前者。
field() {
	awk -v key="$1" '
		function attr_value(line, wanted,    i, n, j, name, q, value) {
			n = length(line)
			i = 1
			while (i <= n) {
				while (i <= n && substr(line, i, 1) !~ /[A-Za-z_]/) i++
				j = i
				while (j <= n && substr(line, j, 1) ~ /[A-Za-z0-9_:-]/) j++
				name = substr(line, i, j - i)
				i = j
				while (i <= n && substr(line, i, 1) ~ /[[:space:]]/) i++
				if (i > n || substr(line, i, 1) != "=") continue
				i++
				while (i <= n && substr(line, i, 1) ~ /[[:space:]]/) i++
				if (i > n) break
				q = substr(line, i, 1)
				if (q == "\"" || q == sprintf("%c", 39)) {
					i++
					j = i
					while (j <= n && substr(line, j, 1) != q) j++
					value = substr(line, i, j - i)
					i = j + 1
				} else {
					j = i
					while (j <= n && substr(line, j, 1) !~ /[[:space:]>]/) j++
					value = substr(line, i, j - i)
					i = j
				}
				if (name == wanted) return value
			}
			return ""
		}
		{
			if (attr_value($0, "name") != key) next
			_value = attr_value($0, "value")
			if (_value != "") {
				print _value
				exit
			}
		}
	' "$2"
}

# --------------------------------------------------------------- 认证流程 ---

# 必填字段: 任一缺失说明门户页面结构变了
LOGIN_FIELDS="ssid mac t wlanacname url nasip wlanuserip"
DEBUG_ONLY=0
AUTH_ERROR_CODE=""
AUTH_ERROR_STAGE=""
AUTH_HTTP_CODE=""
AUTH_ORIGIN=""

do_login() {
	AUTH_ERROR_CODE=""
	AUTH_ERROR_STAGE=""
	AUTH_HTTP_CODE=""
	AUTH_ORIGIN=""
	if [ "$DEBUG_ONLY" = "0" ]; then
		if [ -z "$USERNAME" ]; then
			AUTH_ERROR_CODE=E_CONFIG; AUTH_ERROR_STAGE=config
			log "未配置 USERNAME"
			return 1
		fi
		if [ -z "$PASSWORD" ]; then
			AUTH_ERROR_CODE=E_CONFIG; AUTH_ERROR_STAGE=config
			log "未配置 PASSWORD"
			return 1
		fi
	fi

	# --- 1. 定位门户登录页 ---
	av_state_phase discovering
	_purl=""
	if [ -n "$PORTAL_URL" ]; then
		_ip=$(if_ip4 "$(default_if)")
		_purl=$(printf '%s' "$PORTAL_URL" | sed "s/%WANIP%/${_ip:-10.0.0.1}/g")
		logv "使用配置的登录页地址: $_purl"
	else
		_purl=$(find_portal_url)
		[ -n "$_purl" ] && logv "从重定向解析到登录页: $_purl"
	fi
	if [ -z "$_purl" ]; then
		AUTH_ERROR_CODE=E_PORTAL_NOT_FOUND; AUTH_ERROR_STAGE=portal
		log "未发现门户重定向, 无法定位认证页"
		log "  最后探测: HTTP ${PROBE_CODE:-?}  redirect_url=[${PROBE_LOC:-}]"
		log "  响应头: $(tr -d '\r' < "$TMP/headers" 2>/dev/null | tr '\n' ' ' | head -c 300)"
		log "  响应体: $(head -c 300 "$TMP/body" 2>/dev/null | tr -d '\r\n')"
		return 1
	fi

	_origin=$(printf '%s' "$_purl" | sed -n 's#^\(https\{0,1\}://[^/]*\).*#\1#p')
	[ -n "$_origin" ] || _origin="$PORTAL_BASE"
	AUTH_ORIGIN="$_origin"
	AV_STATE_ORIGIN="$_origin"

	# --- 2. 抓取登录页, 取出隐藏字段 ---
	av_state_phase fetching
	# 必须带 -L: NAS 给的门户地址(实测是 /zportal/login?...) 本身还会再跳一次,
	# 不跟随则只能拿到空 body, 表现为 "无法获取认证页面"。
	_cj="$TMP/cookies"
	rm -f "$TMP/page" "$TMP/tags" "$TMP/page_headers"
	_page_url=$(curl -s -L --max-redirs 5 -m "$HTTP_TIMEOUT" -A "$USER_AGENT" --compressed \
		-H "Accept: $ACCEPT_HTML" \
		-H "Accept-Language: $ACCEPT_LANGUAGE" \
		-H 'Upgrade-Insecure-Requests: 1' \
		-H 'Sec-Fetch-Site: cross-site' \
		-H 'Sec-Fetch-Mode: navigate' \
		-H 'Sec-Fetch-Dest: document' \
		-H 'Connection: keep-alive' \
		-c "$_cj" -b "$_cj" -D "$TMP/page_headers" \
		-o "$TMP/page" -w '%{url_effective}' "$_purl" 2>/dev/null)
	_page_curl_rc=$?
	if [ "$_page_curl_rc" -ne 0 ] || [ ! -s "$TMP/page" ]; then
		AUTH_ERROR_CODE=E_LOGIN_PAGE; AUTH_ERROR_STAGE=page
		log "无法获取认证页面: $_purl"
		log "  跟随跳转后: ${_page_url:-<无>}"
		log "  响应头: $(tr -d '\r' < "$TMP/page_headers" 2>/dev/null | tr '\n' ' ' | head -c 300)"
		return 1
	fi
	tr -d '\r\n' < "$TMP/page" | tr '<' '\n' > "$TMP/tags"

	_missing=""
	for _f in $LOGIN_FIELDS; do
		[ -n "$(field "$_f" "$TMP/tags")" ] || _missing="$_missing $_f"
	done
	if [ -n "$_missing" ]; then
		AUTH_ERROR_CODE=E_LOGIN_FIELDS; AUTH_ERROR_STAGE=page
		log "认证页缺少字段:$_missing (门户页面结构可能已变更)"
		return 1
	fi

	# --- 3. 提交认证 ---
	av_state_phase submitting
	if [ "$DEBUG_ONLY" = "1" ]; then
		echo "  提交地址: $_origin$LOGIN_PATH"
		echo "  提交字段:"
		printf '    %s\n' \
			"qrCodeId=$(field qrCodeId "$TMP/tags")" \
			"username=$USERNAME" "pwd=***" \
			"validCode=$(field validCode "$TMP/tags")" "validCodeFlag=false"
		for _f in $LOGIN_FIELDS; do
			printf '    %s\n' "$_f=$(field "$_f" "$TMP/tags")"
		done
		return 0
	fi

	# Referer 用跟随跳转后的最终地址(与浏览器一致)
	_ref="${_page_url:-$_purl}"

	# 真实浏览器从页面加载到提交至少需要数秒。抓完页面立即 POST 是脚本特征。
	# login_delay 是上限（秒，0 = 关闭），实际在 1..上限 之间随机。
	case "$LOGIN_DELAY" in ''|*[!0-9]*) LOGIN_DELAY=2 ;; esac
	if [ "$LOGIN_DELAY" -gt 0 ]; then
		_rand=${RANDOM:-0}
		case "$_rand" in ''|*[!0-9]*) _rand=0 ;; esac
		_ld_s=$(( (_rand % LOGIN_DELAY) + 1 ))
		logv "登录前随机延迟 ${_ld_s}s"
		sleep "$_ld_s"
	fi

	# 字段名、取值和顺序严格对齐浏览器 #login_form.serialize() 的结果。
	# 注意 qrCodeId / validCode 提交的是页面里的占位文字, 这是浏览器实际行为。
	set -- -s -m "$HTTP_TIMEOUT" -A "$USER_AGENT" --compressed \
		-o "$TMP/resp" -w '%{http_code}' \
		-b "$_cj" -c "$_cj" \
		-H 'Content-Type: application/x-www-form-urlencoded; charset=UTF-8' \
		-H "Accept: */*" \
		-H "Accept-Language: $ACCEPT_LANGUAGE" \
		-H "Origin: $_origin" \
		-H "Referer: $_ref" \
		-H 'X-Requested-With: XMLHttpRequest' \
		-H 'Sec-Fetch-Site: same-origin' \
		-H 'Sec-Fetch-Mode: cors' \
		-H 'Sec-Fetch-Dest: empty' \
		-H 'Connection: keep-alive' \
		--data-urlencode "qrCodeId=$(field qrCodeId "$TMP/tags")" \
		--data-urlencode "username=$USERNAME" \
		--data-urlencode "pwd=$PASSWORD" \
		--data-urlencode "validCode=$(field validCode "$TMP/tags")" \
		--data-urlencode 'validCodeFlag=false'
	for _f in $LOGIN_FIELDS; do
		set -- "$@" --data-urlencode "$_f=$(field "$_f" "$TMP/tags")"
	done
	set -- "$@" "$_origin$LOGIN_PATH"

	_code=$(curl "$@" 2>/dev/null)
	_curl_rc=$?
	AUTH_HTTP_CODE="$_code"
	AV_STATE_HTTP_CODE="$_code"
	if [ "$_curl_rc" -ne 0 ]; then
		AUTH_ERROR_CODE=E_LOGIN_REQUEST; AUTH_ERROR_STAGE=submit
		log "认证请求失败: curl 退出码 $_curl_rc (HTTP ${_code:-?})"
		return 1
	fi

	_result=$(sed -n 's/.*"result"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$TMP/resp" | head -n 1)
	_message=$(sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$TMP/resp" | head -n 1)
	_nextpage=$(sed -n 's/.*"nextPage"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$TMP/resp" | head -n 1)

	case "$_result" in
		success)
			# 浏览器在成功分支会执行 location.href = nextPage, 必须跟上,
			# 否则门户只是回了 success, 授权并未真正下发到 NAS。
			if ! follow_next_page "$_origin" "$_cj" "$_nextpage"; then
				return 1
			fi
			log "认证成功"
			return 0
			;;
		online)
			# 已在线表示 NAS 已有有效会话，不需要依赖授权结果页。
			# 门户若仍返回 nextPage 仍然跟随并校验；缺失时保持兼容。
			if [ -n "$_nextpage" ] && ! follow_next_page "$_origin" "$_cj" "$_nextpage"; then
				return 1
			fi
			log "该 IP 已在线: ${_message:-重复认证}"
			return 0
			;;
	esac

	if [ -z "$_result" ]; then
		AUTH_ERROR_CODE=E_LOGIN_RESPONSE; AUTH_ERROR_STAGE=submit
		log "认证响应无法解析 (HTTP ${_code:-?}): $(head -c 200 "$TMP/resp" 2>/dev/null | tr -d '\r\n')"
	else
		AUTH_ERROR_CODE=E_LOGIN_RESPONSE; AUTH_ERROR_STAGE=submit
		log "认证失败: ${_message:-未知原因} (result=$_result)"
	fi
	case "$_message" in
		*验证码*)
			log "门户要求输入验证码, 请先在浏览器中成功认证一次以清除失败计数"
			;;
		*修改初始密码*)
			log "门户要求修改初始密码, 请先通过自助服务修改"
			;;
	esac
	return 1
}

# 所有可能提交认证请求的入口都经过这里。获取锁不排队：busy 立即返回 3，
# 这样 hotplug 风暴不会在后台堆积多个等待进程。
run_auth_locked() {
	_operation=${1:-once}
	_keep_lock=${2:-0}
	if [ "$LOCK_ENABLED" = "1" ]; then
		auth_lock_acquire "$AUTOVERIFY_SOURCE" "$_operation"
		_lock_rc=$?
		case "$_lock_rc" in
			0) ;;
			3)
				log "已有认证任务运行 (source=$AUTOVERIFY_SOURCE operation=$_operation)"
				return 3
				;;
			*)
				log "无法创建认证锁 (source=$AUTOVERIFY_SOURCE)"
				return 1
				;;
		esac
	fi

	AUTH_ACTIVE=1
	av_state_begin "$AUTOVERIFY_SOURCE" "$_operation" checking
	# post_auth 模式: 认证需要域名解析, 而 DoH 在认证前通常不可达,
	# 先把上游恢复成网络下发的明文 DNS（always 模式下这里是空操作）。
	dns_doh_before_auth
	do_login
	_auth_rc=$?
	if [ "$_auth_rc" != "0" ]; then
		AUTH_ACTIVE=0
		av_state_finish failed failed "${AUTH_ERROR_CODE:-E_LOGIN_REQUEST}" \
			"${AUTH_ERROR_STAGE:-submit}" "$AUTH_HTTP_CODE" "$AUTH_ORIGIN"
		auth_lock_release
		return "$_auth_rc"
	fi
	if [ "$_keep_lock" = "1" ]; then
		# once/daemon 还要在锁内完成最终连通性验证，避免第二个入口在
		# nextPage 成功但 NAS 尚未授权的窗口内再次提交认证。
		return 0
	fi
	AUTH_ACTIVE=0
	if [ "$_operation" = "login" ]; then
		av_state_finish online success "" "" "$AUTH_HTTP_CODE" "$AUTH_ORIGIN"
		dns_doh_after_auth || log "DoH 切换未完成, 保持明文上游"
	fi
	auth_lock_release
	return 0
}

# 取 URL 的 origin，不包含路径、查询串或片段。
url_origin() {
	printf '%s' "${1:-}" | sed -n 's#^\(https\{0,1\}://[^/?]*\).*#\1#p' | head -n 1
}

# 跟随门户返回的 nextPage, 与浏览器 location.href = data.nextPage 一致。
# 严格模式下只允许相对地址或当前门户 origin 的绝对 HTTP(S) 地址，避免认证成功响应
# 把路由器带到第三方地址；同时不把完整查询串写入日志。
follow_next_page() {
	_origin=$1; _cj=$2; _next=$3
	av_state_phase following
	if [ -z "$_next" ]; then
		if [ "$NEXTPAGE_STRICT" = "1" ]; then
			AUTH_ERROR_CODE=E_NEXT_PAGE; AUTH_ERROR_STAGE=nextpage
			log "认证响应缺少 nextPage, 未继续授权流程"
			return 1
		fi
		logv "认证响应未提供 nextPage, 按兼容模式跳过"
		return 0
	fi
	_next_len=$(printf '%s' "$_next" | wc -c | tr -d ' ')
	case "$_next_len" in
		''|*[!0-9]*) _next_len=0 ;;
	esac
	if [ "$_next_len" -gt 2048 ]; then
		AUTH_ERROR_CODE=E_NEXT_PAGE; AUTH_ERROR_STAGE=nextpage
		log "nextPage 过长, 已拒绝"
		return 1
	fi
	case "$_next" in
		http://*|https://*)
		_url="$_next"
		if [ "$NEXTPAGE_STRICT" = "1" ] && [ "$(url_origin "$_url")" != "$_origin" ]; then
			AUTH_ERROR_CODE=E_NEXT_PAGE; AUTH_ERROR_STAGE=nextpage
			log "nextPage 指向外部门户 origin, 已拒绝"
			return 1
		fi
		;;
		/*)    _url="$_origin$_next" ;;
		*)
			case "$_next" in
				*:*|*\\*)
					AUTH_ERROR_CODE=E_NEXT_PAGE; AUTH_ERROR_STAGE=nextpage
					log "nextPage 不是合法的相对 HTTP 路径, 已拒绝"
					return 1
					;;
				*) _url="$_origin/zportal/$_next" ;;
			esac
	esac
	case "$_url" in
		http://*|https://*) ;;
		*)
			AUTH_ERROR_CODE=E_NEXT_PAGE; AUTH_ERROR_STAGE=nextpage
			log "nextPage 无法解析为 HTTP(S) 地址, 已拒绝"
			return 1
			;;
	esac
	_log_url=$(printf '%s' "$_url" | sed 's/[?#].*//')
	logv "跟随 nextPage: $_log_url"
	_code=$(curl -s -m "$HTTP_TIMEOUT" -A "$USER_AGENT" --compressed \
		-H "Accept: $ACCEPT_HTML" \
		-H "Accept-Language: $ACCEPT_LANGUAGE" \
		-H 'Upgrade-Insecure-Requests: 1' \
		-H 'Sec-Fetch-Site: same-origin' \
		-H 'Sec-Fetch-Mode: navigate' \
		-H 'Sec-Fetch-Dest: document' \
		-H 'Connection: keep-alive' \
		-b "$_cj" -c "$_cj" \
		-o /dev/null -w '%{http_code}' "$_url" 2>/dev/null)
	_curl_rc=$?
	AUTH_HTTP_CODE="$_code"
	AV_STATE_HTTP_CODE="$_code"
	if [ "$_curl_rc" -ne 0 ] || [ "$_code" = "000" ] || [ "$_code" -ge 400 ] 2>/dev/null; then
		AUTH_ERROR_CODE=E_NEXT_PAGE; AUTH_ERROR_STAGE=nextpage
		log "nextPage 请求失败: curl=$_curl_rc HTTP=${_code:-?}"
		return 1
	fi
	return 0
}

run_once() {
	if check_online; then
		# 已在线也补一次切换: 开机时会话可能仍然有效, 或刚从 always 模式升级过来。
		dns_doh_after_auth
		logv "在线, 无需认证"
		return 0
	fi
	log "检测到未认证, 开始认证"
	run_auth_locked once 1
	_auth_rc=$?
	if [ "$_auth_rc" = "0" ]; then
		av_state_phase verifying
		sleep 2
		_verify_rc=0
		if check_online; then
			dns_doh_after_auth
			av_state_finish online success "" "" "$AUTH_HTTP_CODE" "$AUTH_ORIGIN"
			log "认证后连通性验证通过"
		else
			av_state_finish failed failed E_VERIFY_OFFLINE verify "$AUTH_HTTP_CODE" "$AUTH_ORIGIN"
			log "认证返回成功但连通性仍不通, 请检查 DNS/路由"
			_verify_rc=1
		fi
		AUTH_ACTIVE=0
		auth_lock_release
		return "$_verify_rc"
	fi
	[ "$_auth_rc" = "3" ] && return 3
	return 1
}

run_daemon() {
	log "守护进程启动 (在线检查间隔 ${CHECK_INTERVAL}s±15%, 失败重试 ${RETRY_INTERVAL}~${MAX_RETRY_INTERVAL}s)"
	_delay="$RETRY_INTERVAL"
	while :; do
		if check_online; then
			# 幂等: 已接管时直接返回。开机/重载后会在这里补切。
			dns_doh_after_auth
			logv "在线"
			_delay="$RETRY_INTERVAL"
			jittered_sleep "$CHECK_INTERVAL" 15
			continue
		fi

		# 退避以“认证后是否真的通了”为准, 而不是以门户的回包为准。
		# 实测门户会在会话没真正建立时也回 result=success, 若以此重置退避,
		# 就会变成每 RETRY_INTERVAL 秒打一次门户。
		if run_auth_locked daemon 1; then
			av_state_phase verifying
			sleep 2
			if check_online; then
				dns_doh_after_auth
				av_state_finish online success "" "" "$AUTH_HTTP_CODE" "$AUTH_ORIGIN"
				log "认证后连通性验证通过"
				_delay="$RETRY_INTERVAL"
				AUTH_ACTIVE=0
				auth_lock_release
				jittered_sleep "$CHECK_INTERVAL" 15
				continue
			fi
			av_state_finish failed failed E_VERIFY_OFFLINE verify "$AUTH_HTTP_CODE" "$AUTH_ORIGIN"
			log "认证返回成功但连通性仍不通"
			AUTH_ACTIVE=0
			auth_lock_release
		else
			_auth_rc=$?
			if [ "$_auth_rc" = "3" ]; then
				logv "认证任务忙, 本轮跳过"
				jittered_sleep "$RETRY_INTERVAL" 20
				continue
			fi
		fi

		_delay=$((_delay * 2))
		[ "$_delay" -gt "$MAX_RETRY_INTERVAL" ] && _delay="$MAX_RETRY_INTERVAL"
		logv "${_delay}s 后重试"
		jittered_sleep "$_delay" 20 "$MAX_RETRY_INTERVAL"
	done
}

run_debug() {
	_wif=$(default_if)
	echo "== 配置 =="
	echo "  来源            : UCI /etc/config/autoverify"
	echo "  账号            : ${USERNAME:-<未设置>}"
	echo "  探测地址        : $PROBE_URLS"
	echo "  期望状态码      : $EXPECT_CODE"
	echo "  登录提交延迟    : ${LOGIN_DELAY}s (1..上限随机, 0=关闭)"
	echo "  门户            : ${PORTAL_BASE:-<未设置, 按地址中的 /zportal/ 自动识别>}"
	echo "  登录页覆盖      : ${PORTAL_URL:-<未设置, 自动探测>}"
	_doh_mode=$(dns_doh_mode)
	if dns_doh_active; then
		_doh_state="已接管 dnsmasq 上游"
	elif [ "$_doh_mode" = "post_auth" ]; then
		_doh_state="未接管 (认证成功后再切)"
	else
		_doh_state="未接管"
	fi
	echo "  DoH 时机        : $_doh_mode"
	echo "  DoH 状态        : $_doh_state"
	echo "  WAN 接口        : ${_wif:-<无默认路由>}"
	echo "  该接口 IP       : $(if_ip4 "$_wif")"
	echo "  该接口 MAC      : $(mac_cisco "$(if_mac "$_wif")")"
	echo "== 连通性 =="
	if check_online; then
		echo "  在线 (无需认证)"
	else
		echo "  离线 (需要认证)"
	fi
	echo "== 认证页与字段 =="
	DEBUG_ONLY=1
	do_login
}

# ---------------------------------------------------------------- 配置校验 ---

validate_error() {
	printf '  错误: %s\n' "$*"
	VALIDATE_ERRORS=$((VALIDATE_ERRORS + 1))
}

validate_warn() {
	printf '  警告: %s\n' "$*"
	VALIDATE_WARNINGS=$((VALIDATE_WARNINGS + 1))
}

validate_bool() {
	case "$2" in
		0|1|on|off|true|false|yes|no|enabled|disabled) ;;
		*) validate_error "$1 必须是布尔值" ;;
	esac
}

validate_uint() {
	case "$2" in
		''|*[!0-9]*) validate_error "$1 必须是正整数"; return 1 ;;
	esac
	[ "$2" -gt 0 ] || validate_error "$1 必须大于 0"
}

validate_range() {
	_name=$1; _value=$2; _min=$3; _max=$4
	case "$_value" in
		''|*[!0-9]*) validate_error "$_name 必须是数字"; return 1 ;;
	esac
	if [ "$_value" -lt "$_min" ] || [ "$_value" -gt "$_max" ]; then
		validate_error "$_name 必须在 $_min..$_max 范围内"
	fi
}

validate_url_list() {
	_count=0
	for _u in $1; do
		_count=$((_count + 1))
		case "$_u" in
			http://?*|https://?*) ;;
			*) validate_error "探测 URL 不支持或为空: $_u" ;;
		esac
	done
	[ "$_count" -gt 0 ] || validate_error "probe_urls 不能为空"
}

run_validate() {
	VALIDATE_ERRORS=0
	VALIDATE_WARNINGS=0
	VALIDATE_ENV_ERRORS=0
	echo "== 配置校验 =="

	validate_bool "main.enabled" "$(av_cfg main enabled "1")"
	[ -n "$USERNAME" ] || validate_error "main.username 不能为空"
	[ -n "$PASSWORD" ] || validate_error "main.password 不能为空"
	validate_range "portal.port" "$PORTAL_PORT" 1 65535
	validate_range "tuning.expect_code" "$EXPECT_CODE" 100 599
	validate_uint "tuning.http_timeout" "$HTTP_TIMEOUT"
	validate_uint "tuning.check_interval" "$CHECK_INTERVAL"
	validate_uint "tuning.retry_interval" "$RETRY_INTERVAL"
	validate_uint "tuning.max_retry_interval" "$MAX_RETRY_INTERVAL"
	validate_range "tuning.login_delay" "$LOGIN_DELAY" 0 10
	if [ "$RETRY_INTERVAL" -gt 0 ] 2>/dev/null && \
		[ "$MAX_RETRY_INTERVAL" -gt 0 ] 2>/dev/null && \
		[ "$RETRY_INTERVAL" -gt "$MAX_RETRY_INTERVAL" ]; then
		validate_error "tuning.retry_interval 不能大于 max_retry_interval"
	fi
	validate_bool "tuning.lock_enabled" "$(av_cfg tuning lock_enabled "1")"
	validate_uint "tuning.lock_max_age" "$LOCK_MAX_AGE"
	validate_bool "tuning.state_enabled" "$(av_cfg tuning state_enabled "1")"
	validate_bool "tuning.nextpage_strict" "$(av_cfg tuning nextpage_strict "1")"
	validate_url_list "$PROBE_URLS"
	[ -n "$USER_AGENT" ] || validate_error "tuning.user_agent 不能为空"

	if [ -n "$PORTAL_URL" ]; then
		case "$PORTAL_URL" in
			http://?*|https://?*) ;;
			*) validate_error "portal.url 必须使用 http:// 或 https://" ;;
		 esac
	fi

	if [ "$(av_cfg_bool ttl enabled "1")" = "1" ]; then
		validate_range "ttl.ttl" "$(av_cfg ttl ttl "64")" 1 255
	fi
	validate_bool "ttl.enabled" "$(av_cfg ttl enabled "1")"
	validate_bool "ntp.enabled" "$(av_cfg ntp enabled "1")"
	validate_bool "dns.enabled" "$(av_cfg dns enabled "1")"
	validate_bool "dns.redirect" "$(av_cfg dns redirect "0")"
	case "$(av_cfg dns mode post_auth)" in
		always|post_auth) ;;
		*) validate_error "dns.mode 只能是 always 或 post_auth" ;;
	esac
	if [ "$(av_cfg_bool dns enabled 0)" = 1 ]; then
		_dns_lib="${AV_DNS_LIB:-${AV_LIB%/*}/dns.sh}"
		if [ -r "$_dns_lib" ]; then
			# shellcheck disable=SC1090
			. "$_dns_lib"
			dns_doh_url || validate_error 'DoH 预设、自定义 HTTPS URL 或 bootstrap IPv4 列表无效'
			# https-dns-proxy 2026.05 与 c-ares 1.34 只给一个 bootstrap 会直接崩溃。
			_n_boot=$(printf '%s\n' "${_doh_bootstrap:-}" | awk -F, 'NF{n=NF} END{print n+0}')
			[ "$_n_boot" -ge 2 ] || validate_warn \
				"dns.doh_bootstrap 只有 $_n_boot 个地址; https-dns-proxy 需要至少两个, 否则会崩溃"
		else
			validate_error '缺少 DNS DoH 配置库'
		fi
	fi
	validate_bool "dhcp.enabled" "$(av_cfg_bool dhcp enabled "1")"
	validate_bool "ipv6.enabled" "$(av_cfg_bool ipv6 enabled "1")"

	if ! command -v curl >/dev/null 2>&1; then
		printf '  环境错误: 未找到 curl\n'
		VALIDATE_ENV_ERRORS=$((VALIDATE_ENV_ERRORS + 1))
	fi
	if ! command -v ip >/dev/null 2>&1; then
		validate_warn "未找到 ip，无法检查接口实际存在性"
	elif [ -n "$WAN_IF" ] && ! ip link show "$WAN_IF" >/dev/null 2>&1; then
		validate_warn "network.wan_if 指定的接口不存在: $WAN_IF"
	fi
	if [ -n "$(av_cfg network lan_dev "br-lan")" ] && command -v ip >/dev/null 2>&1; then
		_lan_dev=$(av_cfg network lan_dev "br-lan")
		ip link show "$_lan_dev" >/dev/null 2>&1 || validate_warn "LAN 接口不存在: $_lan_dev"
	fi
	if [ -f /etc/config/autoverify ] && command -v stat >/dev/null 2>&1; then
		_mode=$(stat -c '%a' /etc/config/autoverify 2>/dev/null || true)
		case "$_mode" in
			600|0600) ;;
			'') validate_warn "无法读取 /etc/config/autoverify 权限" ;;
			*) validate_error "/etc/config/autoverify 权限应为 600，当前为 $_mode" ;;
		esac
	fi

	if [ "$VALIDATE_ERRORS" -gt 0 ]; then
		echo "结论: 配置无效 ($VALIDATE_ERRORS 个错误, $VALIDATE_WARNINGS 个警告)"
		return 1
	fi
	if [ "$VALIDATE_ENV_ERRORS" -gt 0 ]; then
		echo "结论: 环境不完整 ($VALIDATE_WARNINGS 个警告)"
		return 2
	fi
	echo "结论: 配置有效 ($VALIDATE_WARNINGS 个警告)"
	return 0
}

# ---------------------------------------------------------- 状态与审计命令 ---

json_escape() {
	printf '%s' "${1:-}" | tr -d '\r\n' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_string() {
	if [ -n "${1:-}" ]; then
		printf '"%s"' "$(json_escape "$1")"
	else
		printf 'null'
	fi
}

json_number() {
	case "${1:-}" in
		''|*[!0-9]*) printf 'null' ;;
		*) printf '%s' "$1" ;;
	esac
}

load_status_snapshot() {
	STATUS_FILE="$AV_STATE_FILE"
	[ -r "$STATUS_FILE" ] || STATUS_FILE="$AV_STATE_LAST_FILE"
	STATUS_STATE=$(av_state_get "$STATUS_FILE" state)
	STATUS_SOURCE=$(av_state_get "$STATUS_FILE" source)
	STATUS_OPERATION=$(av_state_get "$STATUS_FILE" operation)
	STATUS_STARTED_AT=$(av_state_get "$STATUS_FILE" started_at)
	STATUS_FINISHED_AT=$(av_state_get "$STATUS_FILE" finished_at)
	STATUS_DURATION_MS=$(av_state_get "$STATUS_FILE" duration_ms)
	STATUS_RESULT=$(av_state_get "$STATUS_FILE" result)
	STATUS_ERROR_CODE=$(av_state_get "$STATUS_FILE" error_code)
	STATUS_ERROR_STAGE=$(av_state_get "$STATUS_FILE" error_stage)
	STATUS_HTTP_CODE=$(av_state_get "$STATUS_FILE" http_code)
	STATUS_ORIGIN=$(av_state_get "$STATUS_FILE" portal_origin)
	STATUS_NEXT_RETRY_AT=$(av_state_get "$STATUS_FILE" next_retry_at)
	STATUS_LOCK_PID=$(av_state_get "$STATUS_FILE" lock_pid)
	[ -n "$STATUS_STATE" ] || STATUS_STATE=unknown
	[ -n "$STATUS_RESULT" ] || STATUS_RESULT=unknown
	_daemon_pids=$(pidof autoverify 2>/dev/null || true)
	STATUS_DAEMON_PID=$(printf '%s\n' "$_daemon_pids" | awk '{print $1}')
	STATUS_DAEMON_COUNT=$(printf '%s\n' "$_daemon_pids" | awk '{print NF}')
	[ -n "$STATUS_DAEMON_COUNT" ] || STATUS_DAEMON_COUNT=0
	AUTH_LOCK_DIR="$LOCK_ROOT/auth.lock.d"
	if [ -r "$AUTH_LOCK_DIR/owner" ]; then
		STATUS_LOCK_PID=$(av_state_get "$AUTH_LOCK_DIR/owner" pid)
		STATUS_LOCK_SOURCE=$(av_state_get "$AUTH_LOCK_DIR/owner" source)
		if auth_lock_is_stale; then STATUS_LOCK_STATE=stale; else STATUS_LOCK_STATE=busy; fi
	else
		STATUS_LOCK_PID=""
		STATUS_LOCK_SOURCE=""
		STATUS_LOCK_STATE=free
	fi
}

status_json() {
	printf '{"version":1,"state":%s,"source":%s,"operation":%s,"started_at":%s,"finished_at":%s,"duration_ms":%s,"result":%s,"error_code":%s,"error_stage":%s,"http_code":%s,"portal_origin":%s,"lock_pid":%s,"next_retry_at":%s,"service_enabled":%s,"daemon_pid":%s,"daemon_count":%s,"lock_state":%s,"lock_source":%s,"wan_interface":%s,"wan_ipv4":%s,"ipv6_global":%s,"ipv6_default_route":%s,"probe":%s}\n' \
		"$(json_string "$STATUS_STATE")" "$(json_string "$STATUS_SOURCE")" \
		"$(json_string "$STATUS_OPERATION")" "$(json_number "$STATUS_STARTED_AT")" \
		"$(json_number "$STATUS_FINISHED_AT")" "$(json_number "$STATUS_DURATION_MS")" \
		"$(json_string "$STATUS_RESULT")" "$(json_string "$STATUS_ERROR_CODE")" \
		"$(json_string "$STATUS_ERROR_STAGE")" "$(json_number "$STATUS_HTTP_CODE")" \
		"$(json_string "$STATUS_ORIGIN")" "$(json_number "$STATUS_LOCK_PID")" \
		"$(json_number "$STATUS_NEXT_RETRY_AT")" "$(json_number "$(av_cfg_bool main enabled "1")")" \
		"$(json_number "$STATUS_DAEMON_PID")" "$(json_number "$STATUS_DAEMON_COUNT")" \
		"$(json_string "$STATUS_LOCK_STATE")" "$(json_string "$STATUS_LOCK_SOURCE")" \
		"$(json_string "$AUDIT_IF")" "$(json_string "$AUDIT_IP")" \
		"$(json_string "$AUDIT_IPV6_GLOBAL")" "$(json_string "$AUDIT_IPV6_DEFAULT")" \
		"$(json_string "$STATUS_PROBE")"
}

status_human() {
	echo "== 服务 =="
	if [ "$(av_cfg_bool main enabled "1")" = "1" ]; then
		echo "  enabled       : 是"
	else
		echo "  enabled       : 否"
	fi
	echo "  daemon PID    : ${STATUS_DAEMON_PID:-<未运行>}"
	echo "  daemon 数量   : $STATUS_DAEMON_COUNT"
	echo "== 认证状态 =="
	echo "  当前阶段      : $STATUS_STATE"
	echo "  触发来源      : ${STATUS_SOURCE:-<未知>}"
	echo "  最近结果      : $STATUS_RESULT"
	echo "  最近耗时      : ${STATUS_DURATION_MS:-0} ms"
	echo "  错误码/阶段   : ${STATUS_ERROR_CODE:-<无>} / ${STATUS_ERROR_STAGE:-<无>}"
	echo "  下次重试      : ${STATUS_NEXT_RETRY_AT:-<无>}"
	echo "  认证锁        : $STATUS_LOCK_STATE${STATUS_LOCK_PID:+ (PID $STATUS_LOCK_PID)}"
	echo "== 网络 =="
	echo "  WAN 接口      : ${AUDIT_IF:-unknown}"
	echo "  WAN IPv4      : ${AUDIT_IP:-unknown}"
	echo "  IPv6 全局地址 : ${AUDIT_IPV6_GLOBAL:-unknown}"
	echo "  IPv6 默认路由 : ${AUDIT_IPV6_DEFAULT:-unknown}"
	echo "== 门户摘要 =="
	echo "  HTTP 状态码   : ${STATUS_HTTP_CODE:-<无>}"
	echo "  Portal origin : ${STATUS_ORIGIN:-<无>}"
}

run_check() {
	_check_json=0
	[ "${1:-}" = "--json" ] && _check_json=1
	if check_online; then
		_check_online=1
		_check_rc=0
	else
		_check_online=0
		_check_rc=1
	fi
	if [ "$_check_json" = "1" ]; then
		printf '{"version":1,"online":%s,"http_code":%s}\n' \
			"$_check_online" "$(json_number "${PROBE_CODE:-}")"
	fi
	return "$_check_rc"
}

run_status() {
	_status_probe=0
	_status_json=0
	for _arg in "$@"; do
		case "$_arg" in
			--probe) _status_probe=1 ;;
			--json) _status_json=1 ;;
			'') ;;
			*) printf 'status: 不支持的选项: %s\n' "$_arg" >&2; return 2 ;;
		esac
	done
	if [ "$_status_probe" = "1" ]; then
		if check_online; then STATUS_PROBE=online; else STATUS_PROBE=offline; fi
	else
		STATUS_PROBE=not_run
	fi
	load_status_snapshot
	audit_values
	if [ "$_status_json" = "1" ]; then
		status_json
	else
		status_human
		echo "  本次探测      : $STATUS_PROBE"
	fi
	return 0
}

audit_values() {
	AUDIT_IF=$(default_if)
	AUDIT_IP=""
	AUDIT_DEFAULT_ROUTE=unknown
	AUDIT_LAN_DEV=$(av_cfg network lan_dev "br-lan")
	AUDIT_LAN_PRESENT=unknown
	AUDIT_IPV6_GLOBAL=unknown
	AUDIT_IPV6_DEFAULT=unknown
	AUDIT_TTL_LOADED=unknown
	AUDIT_DNS_RULE_UDP=unknown
	AUDIT_DNS_RULE_TCP=unknown
	AUDIT_NTP_RULE=unknown
	AUDIT_DNS_UDP_LISTEN=unknown
	AUDIT_DNS_TCP_LISTEN=unknown
	AUDIT_NTP_LISTEN=unknown
	AUDIT_RA=unknown
	AUDIT_DHCPV6=unknown
	AUDIT_FLOWTABLE=unknown
	AUDIT_TTL_FILE=absent
	[ -e /etc/nftables.d/20-ttl-normalize.nft ] && AUDIT_TTL_FILE=present
	if command -v ip >/dev/null 2>&1; then
		AUDIT_DEFAULT_ROUTE=$(ip route show default 2>/dev/null | head -n 1)
		[ -n "$AUDIT_DEFAULT_ROUTE" ] || AUDIT_DEFAULT_ROUTE=unknown
		[ -n "$AUDIT_IF" ] && AUDIT_IP=$(if_ip4 "$AUDIT_IF")
		if [ -n "$AUDIT_LAN_DEV" ] && ip link show "$AUDIT_LAN_DEV" >/dev/null 2>&1; then
			AUDIT_LAN_PRESENT=yes
		else
			AUDIT_LAN_PRESENT=no
		fi
		if ip -6 addr show scope global 2>/dev/null | grep -q 'inet6 '; then
			AUDIT_IPV6_GLOBAL=yes
		else
			AUDIT_IPV6_GLOBAL=no
		fi
		if ip -6 route show default 2>/dev/null | grep -q .; then
			AUDIT_IPV6_DEFAULT=yes
		else
			AUDIT_IPV6_DEFAULT=no
		fi
	fi
	if command -v netstat >/dev/null 2>&1; then
		AUDIT_DNS_UDP_LISTEN=$(netstat -lnu 2>/dev/null | grep -cE ':53[[:space:]]' || true)
		AUDIT_DNS_TCP_LISTEN=$(netstat -lnt 2>/dev/null | grep -cE ':53[[:space:]]' || true)
		AUDIT_NTP_LISTEN=$(netstat -lnu 2>/dev/null | grep -cE ':123[[:space:]]' || true)
	fi
	if command -v nft >/dev/null 2>&1; then
		_nft_rules=$(nft list ruleset 2>/dev/null)
		_nft_rc=$?
		if [ "$_nft_rc" -eq 0 ]; then
			case "$_nft_rules" in *ttl_normalize*) AUDIT_TTL_LOADED=yes ;; *) AUDIT_TTL_LOADED=no ;; esac
			case "$_nft_rules" in *dns-converge-udp*) AUDIT_DNS_RULE_UDP=yes ;; *) AUDIT_DNS_RULE_UDP=no ;; esac
			case "$_nft_rules" in *dns-converge-tcp*) AUDIT_DNS_RULE_TCP=yes ;; *) AUDIT_DNS_RULE_TCP=no ;; esac
			case "$_nft_rules" in *ntp-converge*) AUDIT_NTP_RULE=yes ;; *) AUDIT_NTP_RULE=no ;; esac
			case "$_nft_rules" in *flowtable*) AUDIT_FLOWTABLE=yes ;; *) AUDIT_FLOWTABLE=no ;; esac
		fi
	fi
	if command -v uci >/dev/null 2>&1; then
		AUDIT_RA=$(uci -q get dhcp.lan.ra 2>/dev/null) || AUDIT_RA=unknown
		AUDIT_DHCPV6=$(uci -q get dhcp.lan.dhcpv6 2>/dev/null) || AUDIT_DHCPV6=unknown
		[ -n "$AUDIT_RA" ] || AUDIT_RA=unknown
		[ -n "$AUDIT_DHCPV6" ] || AUDIT_DHCPV6=unknown
	fi
}

audit_json() {
	load_status_snapshot
	audit_values
	printf '{"version":1,"state":%s,"result":%s,"daemon_count":%s,"lock_state":%s,"checks":[{"name":"wan_interface","value":%s},{"name":"wan_ipv4","value":%s},{"name":"default_route","value":%s},{"name":"lan_device","value":%s},{"name":"lan_device_present","value":%s},{"name":"ipv6_global","value":%s},{"name":"ipv6_default_route","value":%s},{"name":"ttl_rule_file","value":%s},{"name":"ttl_rule_loaded","value":%s},{"name":"dns_redirect_udp","value":%s},{"name":"dns_redirect_tcp","value":%s},{"name":"ntp_redirect","value":%s},{"name":"flowtable","value":%s},{"name":"dns_udp53_listeners","value":%s},{"name":"dns_tcp53_listeners","value":%s},{"name":"ntp_udp123_listeners","value":%s},{"name":"lan_ra","value":%s},{"name":"lan_dhcpv6","value":%s}],"coverage":["DoH 不受 DNS redirect 覆盖","HTTPS/TLS 与 QUIC 指纹不由本项目处理","并发连接和流量行为不由本项目处理","flow offloading 可能使 TTL 覆盖不完整"]}\n' \
		"$(json_string "$STATUS_STATE")" "$(json_string "$STATUS_RESULT")" \
		"$(json_number "$STATUS_DAEMON_COUNT")" "$(json_string "$STATUS_LOCK_STATE")" \
		"$(json_string "$AUDIT_IF")" "$(json_string "$AUDIT_IP")" \
		"$(json_string "$AUDIT_DEFAULT_ROUTE")" "$(json_string "$AUDIT_LAN_DEV")" \
		"$(json_string "$AUDIT_LAN_PRESENT")" "$(json_string "$AUDIT_IPV6_GLOBAL")" \
		"$(json_string "$AUDIT_IPV6_DEFAULT")" "$(json_string "$AUDIT_TTL_FILE")" \
		"$(json_string "$AUDIT_TTL_LOADED")" "$(json_string "$AUDIT_DNS_RULE_UDP")" \
		"$(json_string "$AUDIT_DNS_RULE_TCP")" "$(json_string "$AUDIT_NTP_RULE")" \
		"$(json_string "$AUDIT_FLOWTABLE")" "$(json_number "$AUDIT_DNS_UDP_LISTEN")" \
		"$(json_number "$AUDIT_DNS_TCP_LISTEN")" "$(json_number "$AUDIT_NTP_LISTEN")" \
		"$(json_string "$AUDIT_RA")" "$(json_string "$AUDIT_DHCPV6")"
}

run_audit() {
	case "${1:-}" in
		--json) audit_json; return 0 ;;
		'') ;;
		*) printf 'audit: 不支持的选项: %s\n' "$1" >&2; return 2 ;;
	esac
	load_status_snapshot
	audit_values
	status_human
	echo "== 网络路径 =="
	echo "  WAN 接口      : ${AUDIT_IF:-unknown}"
	echo "  WAN IPv4      : ${AUDIT_IP:-unknown}"
	echo "  默认路由      : ${AUDIT_DEFAULT_ROUTE:-unknown}"
	echo "  LAN 接口      : ${AUDIT_LAN_DEV:-unknown} (${AUDIT_LAN_PRESENT:-unknown})"
	echo "  IPv6 全局地址 : $AUDIT_IPV6_GLOBAL"
	echo "  IPv6 默认路由 : $AUDIT_IPV6_DEFAULT"
	echo "== 防火墙与服务 =="
	echo "  TTL 规则文件  : $AUDIT_TTL_FILE"
	echo "  TTL 已加载    : $AUDIT_TTL_LOADED"
	echo "  DNS redirect  : UDP=$AUDIT_DNS_RULE_UDP TCP=$AUDIT_DNS_RULE_TCP"
	echo "  NTP redirect  : $AUDIT_NTP_RULE"
	echo "  flowtable     : $AUDIT_FLOWTABLE"
	echo "  DNS UDP/53    : $AUDIT_DNS_UDP_LISTEN"
	echo "  DNS TCP/53    : $AUDIT_DNS_TCP_LISTEN"
	echo "  NTP UDP/123   : $AUDIT_NTP_LISTEN"
	echo "  LAN RA/DHCPv6 : $AUDIT_RA / $AUDIT_DHCPV6"
	echo "== 覆盖范围说明 =="
	echo "  DoH 不受 DNS redirect 覆盖"
	echo "  HTTPS/TLS 与 QUIC 指纹不由本项目处理"
	echo "  flow offloading 可能使 TTL 规则覆盖不完整"
	return 0
}

# ----------------------------------------------------------------- 工具 ----

# 从 JSON 文本里取一个字符串字段。输出是压缩成一行的, 所以不能简单地贪心匹配。
json_str() {
	grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$2" 2>/dev/null \
		| head -n 1 | sed 's/^[^:]*:[[:space:]]*"//; s/"$//'
}

# 本机安装的包版本。非 apk/opkg 安装(比如直接铺文件)时返回空。
installed_version() {
	if command -v apk >/dev/null 2>&1; then
		apk list -I autoverify 2>/dev/null \
			| sed -n 's/^autoverify-\([^ ]*\) .*/\1/p' | head -n 1
	elif command -v opkg >/dev/null 2>&1; then
		opkg list-installed autoverify 2>/dev/null \
			| sed -n 's/^autoverify - \([^ ]*\).*/\1/p' | head -n 1
	fi
}

# 把版本号折算成整数用于比较。1.0.0-r7 -> 1000000007。
# 只取纯数字段, 所以中间的 r 会被跳过; 两侧用同一套规则, 比较是可靠的。
ver_num() {
	printf '%s' "$1" | tr -c '0-9' '\n' \
		| awk '$0 ~ /^[0-9]+$/ { v = v * 1000 + $0; n++ } END { if (n) printf "%d", v; else printf "0" }'
}

# --------------------------------------------------------------- 检测更新 ---

# 查 GitHub Releases 上最新版本, 与本机安装的包版本比对。
# 只读: 不下载、不安装、不改任何配置。
#
# 退出码: 0 = 已是最新   1 = 有新版本   2 = 查询失败, 无法判断
cmd_update_check() {
	_repo="${UPDATE_REPO:-RealCaCl2/joywise-autoverify}"
	_local=$(installed_version)

	echo "== 本机 =="
	if [ -n "$_local" ]; then
		echo "  安装版本: $_local"
	else
		echo "  安装版本: <读不到, 可能不是用 apk/opkg 安装的>"
	fi

	echo "== 查询 Releases =="
	echo "  仓库: $_repo"
	_json="$TMP/release.json"
	# GitHub API 不带 User-Agent 会返 403。未认证时限流 60 次/小时,
	# 手动点一下完全够用, 所以不做缓存。
	_code=$(curl -s -L -m "$HTTP_TIMEOUT" -A "$USER_AGENT" \
		-o "$_json" -w '%{http_code}' \
		"https://api.github.com/repos/$_repo/releases/latest" 2>/dev/null)

	if [ "$_code" != "200" ]; then
		echo "  查询失败: HTTP ${_code:-?}"
		case "$_code" in
			000) echo "  (网络不通或 DNS 解析失败)" ;;
			403) echo "  (GitHub API 限流: 未认证时每 IP 每小时 60 次, 等一会儿再试)" ;;
			404) echo "  (仓库不存在, 或还没有发布 Release)" ;;
		esac
		return 2
	fi

	_tag=$(json_str tag_name "$_json")
	_at=$(json_str published_at "$_json")
	# 优先用 apk 资产名里的版本号 —— 它与本机包版本是同一套编号。
	# tag 是语义化的(v1.0.2), 和包的 1.0.0-r6 不是一回事, 拿 tag 比会永远“有新版本”。
	_remote=$(grep -o 'autoverify-[0-9][^"]*\.apk' "$_json" 2>/dev/null \
		| head -n 1 | sed 's/^autoverify-//; s/\.apk$//')
	[ -n "$_remote" ] || _remote=${_tag#v}

	echo "== 最新 Release =="
	echo "  tag      : ${_tag:-?}"
	echo "  发布时间 : ${_at:-?}"
	echo "  包版本   : ${_remote:-?}"
	echo "  页面     : https://github.com/$_repo/releases/latest"

	echo "== 结论 =="
	if [ -z "$_local" ] || [ -z "$_remote" ]; then
		echo "  无法比对: 本机或远程版本读不到"
		return 2
	fi
	if [ "$(ver_num "$_remote")" -gt "$(ver_num "$_local")" ]; then
		echo "  有新版本: $_local -> $_remote"
		echo "  下载: https://github.com/$_repo/releases/latest"
		return 1
	fi
	echo "  已是最新版本 ($_local)"
	return 0
}

# ------------------------------------------------------------------- 入口 ---

need_curl
[ -n "$PROBE_URLS" ] || die "PROBE_URLS 为空, 无法判断连通性"
TMP=$(mktemp -d "${TMPDIR:-/tmp}/autoverify.XXXXXX") || die "无法创建临时目录"
STOP_REQUESTED=0
AUTH_ACTIVE=0
av_state_init

cleanup() {
	auth_lock_release
	rm -rf "$TMP"
}

on_signal() {
	STOP_REQUESTED=1
	if [ "${AUTH_ACTIVE:-0}" = "1" ]; then
		av_state_finish interrupted failed E_INTERRUPTED signal "$AUTH_HTTP_CODE" "$AUTH_ORIGIN"
	fi
	# 信号到达认证阶段时立即释放本进程持有的锁；退出 trap 会再次幂等清理。
	auth_lock_release
	if [ "${AUTH_ACTIVE:-0}" = "1" ]; then
		exit 1
	fi
	exit 0
}

trap 'on_signal' INT TERM
trap 'cleanup' EXIT

# -v/--verbose: 临时打开详细日志。
# 必须放在这里: 配置文件会覆盖同名环境变量, 所以 `VERBOSE=1 autoverify once` 在
# 路由器上是无效的, 要用 `autoverify -v once`。
case "${1:-}" in
	-v|--verbose) VERBOSE=1; shift ;;
esac

case "${1:-once}" in
	check)  shift; run_check "$@" ;;
	login)  run_auth_locked login ;;
	once)   run_once ;;
	daemon) run_daemon ;;
	debug)  run_debug ;;
	validate) run_validate ;;
	status) shift; run_status "$@" ;;
	audit) shift; run_audit "$@" ;;
	update-check) cmd_update_check ;;
	*)
		printf '用法: %s [-v] {check|login|once|daemon|debug|validate|status|audit|update-check}\n' "$0" >&2
		exit 2
		;;
esac
