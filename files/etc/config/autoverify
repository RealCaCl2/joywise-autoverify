
config autoverify 'main'
	option enabled '1'
	# 校园网账号密码。留空请去 LuCI 页面(服务 -> 校园网自动认证)填。
	option username ''
	option password ''

config autoverify 'portal'
	# 你所在学校的门户地址。留空则从探测响应里的 /zportal/ 自动识别, 大多数 zportal
	# 学校都不需要填。只有"门户返回的是相对路径"时, 才必须填 host 才能补全。
	option host ''
	option port '9090'
	option url ''

config autoverify 'tuning'
	option probe_urls 'http://connect.rom.miui.com/generate_204 http://connectivitycheck.platform.hicloud.com/generate_204 http://wifi.vivo.com.cn/generate_204'
	option expect_code '204'
	option http_timeout '8'
	option check_interval '60'
	option retry_interval '20'
	option max_retry_interval '300'
	option verbose '0'
	# 认证入口互斥锁。旧配置缺失时脚本也会按这些默认值工作。
	option lock_enabled '1'
	option lock_max_age '300'
	option state_enabled '1'
	option nextpage_strict '1'
	# 请求 User-Agent。探测是明文 HTTP, 校园网 DPI 看得见 —— 不要带任何能标识
	# 本项目或 OpenWrt 的字样, 也不要填虚构/过时的串。
	option user_agent 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36'

config autoverify 'network'
	option wan_if ''
	option hotplug_if 'wwan'
	option lan_dev 'br-lan'

config hardening 'ttl'
	option enabled '1'
	option ttl '64'

config hardening 'ntp'
	option enabled '1'
	option server 'ntp.aliyun.com time1.cloud.tencent.com'

config hardening 'dns'
	option enabled '1'
	# DoH 与 LAN DNS 接管分开。默认允许客户端使用自己的 DNS（兼容 Clash）。
	option redirect '0'
	# 预设: tencent / aliyun / custom。普通查询只走 DoH。
	option doh_provider 'tencent'
	# 以下仅用于 custom；bootstrap 只解析 DoH 服务域名。
	option doh_url ''
	option doh_bootstrap '119.29.29.29'

config hardening 'dhcp'
	option enabled '1'
	# 冒充成什么主机名。留空 = 首次应用时随机生成一个 LAPTOP-XXXXXXXX
	# 并写回到这里(只生成一次, 之后保持不变)。
	option hostname ''
	# 冒充成什么厂商。Windows 发的是 MSFT 5.0。
	# 留空会退回 OpenWrt 默认值 "udhcp <版本号>", 等于直接报出 DHCP 客户端实现。
	option vendorid 'MSFT 5.0'
	# 要改哪个 UCI 接口。
	option iface 'wan'

config hardening 'ipv6'
	option enabled '1'
